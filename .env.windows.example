############################################
# LightRAG Windows 示例配置（请复制为 .env）
# 说明：本文件仅示例，所有密钥均为占位符。
############################################

###########################
# Server 基础配置
###########################
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE=My Graph KB
WEBUI_DESCRIPTION=Simple and Fast Graph Based RAG System

# 可选：目录配置
# INPUT_DIR=./inputs
# WORKING_DIR=./rag_storage

############################################################
# 方案 A：OpenAI API（推荐先跑通）
# 使用前请删除注释并填入你自己的值
############################################################
# LLM_BINDING=openai
# LLM_BINDING_HOST=https://api.openai.com/v1
# LLM_BINDING_API_KEY=<YOUR_OPENAI_API_KEY>
# LLM_MODEL=gpt-5-mini
#
# EMBEDDING_BINDING=openai
# EMBEDDING_BINDING_HOST=https://api.openai.com/v1
# EMBEDDING_BINDING_API_KEY=<YOUR_OPENAI_API_KEY>
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072

############################################################
# 方案 B：Ollama 本地模型（离线/本地优先）
# 使用前请删除注释并填入你自己的值
############################################################
# LLM_BINDING=ollama
# LLM_BINDING_HOST=http://127.0.0.1:11434
# LLM_BINDING_API_KEY=<OPTIONAL_OR_EMPTY>
# LLM_MODEL=<YOUR_OLLAMA_LLM_MODEL>
# OLLAMA_LLM_NUM_CTX=32768
#
# EMBEDDING_BINDING=ollama
# EMBEDDING_BINDING_HOST=http://127.0.0.1:11434
# EMBEDDING_BINDING_API_KEY=<OPTIONAL_OR_EMPTY>
# EMBEDDING_MODEL=<YOUR_OLLAMA_EMBED_MODEL>
# EMBEDDING_DIM=<YOUR_EMBED_DIM>

###########################
# Reranker（可选）
###########################
RERANK_BINDING=null
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_BINDING_HOST=http://127.0.0.1:8000/rerank
# RERANK_BINDING_API_KEY=<YOUR_RERANK_API_KEY>

###########################
# 其他常用可选项
###########################
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2
SUMMARY_LANGUAGE=English

# API 鉴权（可选）
# LIGHTRAG_API_KEY=<YOUR_LIGHTRAG_API_KEY>

# 上传大小限制（默认 100MB）
# MAX_UPLOAD_SIZE=104857600
